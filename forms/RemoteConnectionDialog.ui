     <item row="7" column="1"><widget class="QLineEdit" name="remoteRootEdit"><property name="text"><string>/</string></property></widget></item>
     <item row="8" column="1"><widget class="QCheckBox" name="passiveModeCheckBox"><property name="text"><string>Пассивный режим FTP</string></property><property name="checked"><bool>true</bool></property></widget></item>
     <item row="9" column="1"><widget class="QCheckBox" name="saveProfileCheckBox"><property name="text"><string>Сохранить профиль подключения</string></property><property name="checked"><bool>true</bool></property></widget></item>
     <item row="10" column="1"><widget class="QCheckBox" name="rememberPasswordCheckBox"><property name="text"><string>Сохранить пароль в локальном файле настроек</string></property><property name="toolTip"><string>Для учебного проекта пароль можно сохранить локально. В промышленном ПО лучше использовать защищённое хранилище ОС.</string></property></widget></item>
